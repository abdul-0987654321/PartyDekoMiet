# ─────────────────────────────────────────────────────────────────────────────
# PartyDekoMiet – WhatsApp AI Agent
# Copy this file to .env for local development.
# On Render, set the same keys under Environment > Environment Variables.
# NEVER commit a real .env — only this example file belongs in git.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Storage: Google Sheet via Apps Script ─────────────────────────────────
# Render's free disk is wiped on every restart/deploy, so everything that must
# survive a restart (WhatsApp login, customers, bookings, chat) lives in a Google
# Sheet. Deploy apps-script/Code.gs as a Web App and paste its /exec URL here.
# Setup: docs/GOOGLE_SHEET_SETUP.md
SHEET_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
# Must match the SECRET script property in the Apps Script project. Long + random.
SHEET_SECRET=change-me-long-random-string
# How long writes are batched before one request is sent to the sheet (ms).
STORAGE_FLUSH_MS=1500

# ── 2. OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Speech-to-text for voice notes (customers and the owner's voice commands)
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
# Max tool-calling rounds per customer message (stops runaway loops).
AGENT_MAX_STEPS=6

# ── 3. WhatsApp ──────────────────────────────────────────────────────────────
# Owner number for booking notifications and owner commands (/pause, /resume, /status).
# International format, no "+", no spaces. Swiss mobile example: 41791234567
OWNER_WHATSAPP=41790000000
# If the owner answers a customer manually from the phone, the bot pauses that chat.
TAKEOVER_PAUSE_HOURS=12
# Human-like "typing…" delay before every outgoing message (ban-risk mitigation).
TYPING_MIN_MS=2000
TYPING_MAX_MS=5000
# Safety cap so a loop or a troll can never spam one chat.
MAX_MSGS_PER_CHAT_PER_HOUR=30

# ── 4. Google Calendar (availability + booking events) ───────────────────────
# The calendar the client shares with the service account.
GOOGLE_CALENDAR_ID=xxxxxxxx@group.calendar.google.com
# Service account key. Easiest: paste the CONTENTS of the downloaded .json file
# here as one line (it starts with { and ends with }). No base64 needed.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative, if you prefer base64 of the same file. Only set one of the two.
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# Fallback only if a service account turns out to be impossible — not recommended,
# refresh tokens expire after 7 days while the Google app stays in "Testing" mode.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# ── 5. Shopify catalog (public JSON, no admin access needed) ─────────────────
SHOP_URL=https://partydekomiet.ch
# products.json is re-fetched this often; the last good copy is cached in the sheet.
CATALOG_REFRESH_HOURS=6
# Optional: if the shop has a separate "deposit" product the customer must add.
# DEPOSIT_PRODUCT_URL=

# ── 6. Business rules (from the AGB — env overrides knowledge/business.json) ──
RENTAL_DAYS=3
# Return day = pickup + this many days. 2 = pickup Friday, return Sunday
# (three consecutive days, pickup day counts as day 1). 3 = return Monday.
# Also editable in the dashboard under Settings.
RETURN_DAY_OFFSET=2
DEPOSIT_CHF=50
LATE_FEE_CHF=50
PICKUP_ADDRESS=Langstrasse 175, 8004 Zürich (SBB-Bürogebäude, Erdgeschoss)
# Pickup/return windows the bot may propose, e.g. "Mo-Fr 17:00-19:00, Sa 10:00-14:00"
PICKUP_HOURS=
# Extra days blocked after each return for checking/cleaning. 0 = back-to-back allowed.
BUFFER_DAYS=0
# Shown when the bot hands a case over to a human.
HANDOFF_PHONE=

# Most of the values below are also editable in the dashboard, which overrides
# this file. Secrets (keys, passwords) stay here only.

# ── 6b. Studio (second bot, same deploy) ─────────────────────────────────────
# Everything below also lives in the dashboard under Settings > Studio and can
# be set there instead — these env vars are only a fallback/bootstrap, useful if
# the dashboard save ever fails (e.g. the Google Sheet is unreachable).
STUDIO_OWNER_WHATSAPP=
STUDIO_ALERT_NUMBERS=
# Its own calendar, separate from GOOGLE_CALENDAR_ID above. Share this calendar
# with the SAME service-account email used for GOOGLE_SERVICE_ACCOUNT_JSON(_B64).
STUDIO_CALENDAR_ID=
STUDIO_MIN_NOTICE_HOURS=1
STUDIO_BUFFER_MIN=15
# onsite | advance
STUDIO_PAYMENT_MODE=onsite
STUDIO_CANCELLATION_RULE=
STUDIO_CONFIRMATION_EXAMPLE=
STUDIO_BLOCKED_KEYWORDS=blocked,geschlossen,ferien,closed,urlaub
# STUDIO_BOT_ENABLED=true

# ── 7. Web (QR login page + owner dashboard) ─────────────────────────────────
PORT=3000
# Protects the QR page and the dashboard. Long + random.
DASHBOARD_PASSWORD=change-me
# Public Render URL, used in owner notifications. e.g. https://partydekomiet-bot.onrender.com
PUBLIC_URL=

# ── 8. Runtime ───────────────────────────────────────────────────────────────
TZ=Europe/Zurich
NODE_ENV=production
LOG_LEVEL=info
# "files" = knowledge/ folder (this bot).
# "sheet" = owner edits FAQ/prices in the Google Sheet (planned for bot #2).
KNOWLEDGE_SOURCE=files
